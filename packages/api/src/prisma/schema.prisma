// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Hotel {
  id                 String          @id @default(uuid())
  created_at         DateTime        @default(now())
  updated_at         DateTime        @updatedAt
  nome_hotel         String          @db.VarChar(100)
  razao_social       String          @db.VarChar(100)
  nome_fantasia      String          @db.VarChar(100)
  cnpj               String          @unique @db.VarChar(14)
  email_comercial    String          @unique @db.VarChar(255)
  telefone_comercial String          @db.VarChar(11)
  celular            String?         @db.VarChar(20)
  website            String?
  status             String          @default("S") @db.Char(1)

  enderecos          HotelEndereco[]
  users              User[]
  grupos             Grupo[]
  rotas_hoteis       RotaHotel[]
  categorias_quarto  CategoriaQuarto[]
  quartos            Quarto[]
  tarifarios         Tarifario[]
  regimes_alimentacao RegimeAlimentacao[]
  leads              Lead[]
  orcamentos         Orcamento[]
  parceiros_comerciais ParceiroComercial[]
  reservas           Reserva[]

  @@map("hoteis")
}

model HotelEndereco {
  id          String   @id @default(uuid())
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  hotel_id    String
  hotel       Hotel    @relation(fields: [hotel_id], references: [id], onDelete: Cascade)
  rua         String   @db.VarChar(100)
  numero      String   @db.VarChar(10)
  bairro      String   @db.VarChar(50)
  complemento String?
  cep         String   @db.VarChar(8)
  cidade      String   @db.VarChar(50)
  estado      String   @db.VarChar(2)

  @@index([hotel_id])
  @@map("hoteis_enderecos")
}

model User {
  id            String   @id @default(uuid())
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  hotel_id      String
  hotel         Hotel    @relation(fields: [hotel_id], references: [id], onDelete: Cascade)
  nome_completo String   @db.VarChar(255)
  email         String   @unique @db.VarChar(255)
  senha         String   @db.Text
  nascimento    DateTime @db.Date
  genero        String   @db.VarChar(20)
  celular       String   @unique @db.VarChar(20)
  cpf           String   @unique @db.VarChar(14)
  rg            String?  @unique
  grupos_ids    String?  @db.Text

  @@index([hotel_id])
  @@map("users")
}

model Grupo {
  id         String      @id @default(uuid())
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt
  hotel_id   String
  hotel      Hotel       @relation(fields: [hotel_id], references: [id], onDelete: Cascade)
  grupo      String      @db.VarChar(100)
  descricao  String?     @db.Text
  status     String      @default("S") @db.Char(1)
  rotas      GrupoRota[]

  @@unique([hotel_id, grupo])
  @@index([hotel_id])
  @@index([grupo])
  @@map("grupos")
}

model Rota {
  id         String      @id @default(uuid())
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt
  modulo     String      @db.VarChar(100)
  recurso    String      @db.VarChar(100)
  rota       String      @db.VarChar(255)
  icone      String?     @db.VarChar(50)
  ordem      Int         @default(0)
  ativo      Boolean     @default(true)
  hoteis     RotaHotel[]
  grupos     GrupoRota[]

  @@map("rotas")
}

model RotaHotel {
  id         String   @id @default(uuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  hotel_id   String
  hotel      Hotel    @relation(fields: [hotel_id], references: [id], onDelete: Cascade)
  rota_id    String
  rota       Rota     @relation(fields: [rota_id], references: [id], onDelete: Cascade)

  @@unique([hotel_id, rota_id])
  @@index([hotel_id])
  @@map("rotas_hoteis")
}

model GrupoRota {
  id         String   @id @default(uuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  grupo_id   String
  grupo      Grupo    @relation(fields: [grupo_id], references: [id], onDelete: Cascade)
  rota_id    String
  rota       Rota     @relation(fields: [rota_id], references: [id], onDelete: Cascade)

  @@unique([grupo_id, rota_id])
  @@index([grupo_id])
  @@map("grupos_rotas")
}

model Administrator {
  id            String   @id @default(uuid())
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  nome_completo String   @db.VarChar(200)
  email         String   @unique @db.VarChar(150)
  senha         String   @db.Text
  status        String   @default("S") @db.Char(1)

  @@map("administrators")
}

model CategoriaQuarto {
  id         String   @id @default(uuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  hotel_id   String
  hotel      Hotel    @relation(fields: [hotel_id], references: [id], onDelete: Cascade)
  nome       String   @db.VarChar(100)
  status     String      @default("S") @db.Char(1)
  quartos    Quarto[]
  tarifarios Tarifario[]
  orcamentos Orcamento[]

  @@unique([hotel_id, nome])
  @@index([hotel_id])
  @@map("categorias_quartos")
}

model Quarto {
  id               String             @id @default(uuid())
  created_at       DateTime           @default(now())
  updated_at       DateTime           @updatedAt
  hotel_id         String
  hotel            Hotel              @relation(fields: [hotel_id], references: [id], onDelete: Cascade)
  categoria_id     String
  categoria        CategoriaQuarto    @relation(fields: [categoria_id], references: [id], onDelete: Restrict)
  identificacao    String             @db.VarChar(30)
  descricao        String?            @db.Text
  limite_hospedes  Int
  status           String             @default("S") @db.Char(1)
  camas            ConfiguracaoCama[]
  reservas         Reserva[]

  @@unique([hotel_id, identificacao])
  @@index([hotel_id])
  @@index([categoria_id])
  @@map("quartos")
}

model ConfiguracaoCama {
  id          String   @id @default(uuid())
  quarto_id   String
  quarto      Quarto   @relation(fields: [quarto_id], references: [id], onDelete: Cascade)
  tipo        String   @db.VarChar(30)
  quantidade  Int

  @@unique([quarto_id, tipo])
  @@index([quarto_id])
  @@map("quartos_camas")
}

model Tarifario {
  id                  String             @id @default(uuid())
  hotel_id            String
  hotel               Hotel              @relation(fields: [hotel_id], references: [id], onDelete: Cascade)
  categoria_quarto_id String
  categoria_quarto    CategoriaQuarto   @relation(fields: [categoria_quarto_id], references: [id], onDelete: Restrict)
  regime_alimentacao_id String
  regime_alimentacao  RegimeAlimentacao @relation(fields: [regime_alimentacao_id], references: [id], onDelete: Restrict)
  nome                String            @db.VarChar(100)
  valor_diaria        Decimal            @db.Decimal(12, 2)
  ativo               Boolean            @default(true)
  datas               TarifarioData[]
  criado_em           DateTime           @default(now())
  atualizado_em       DateTime           @updatedAt

  @@index([hotel_id])
  @@index([categoria_quarto_id])
  @@index([regime_alimentacao_id])
  @@index([hotel_id, categoria_quarto_id, ativo])
  @@map("tarifarios")
}

model TarifarioData {
  id           String    @id @default(uuid())
  tarifario_id String
  tarifario    Tarifario @relation(fields: [tarifario_id], references: [id], onDelete: Cascade)
  data         DateTime  @db.Date

  @@unique([tarifario_id, data])
  @@index([tarifario_id])
  @@index([data])
  @@map("tarifarios_datas")
}

model RegimeAlimentacao {
  id           String   @id @default(uuid())
  hotel_id     String
  hotel        Hotel    @relation(fields: [hotel_id], references: [id], onDelete: Cascade)
  titulo       String   @db.VarChar(100)
  descricao    String?  @db.Text
  cor_pulseira String   @db.VarChar(20)
  ativo        Boolean  @default(true)
  tarifarios   Tarifario[]
  orcamentos   Orcamento[]
  reservas     Reserva[]
  criado_em    DateTime @default(now())
  atualizado_em DateTime @updatedAt

  @@unique([hotel_id, titulo])
  @@index([hotel_id])
  @@index([hotel_id, ativo])
  @@map("regimes_alimentacao")
}

model Lead {
  id         String      @id @default(uuid())
  hotel_id   String
  nome       String      @db.VarChar(150)
  telefone   String      @db.VarChar(30)
  email      String      @db.VarChar(150)
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt

  hotel      Hotel       @relation(fields: [hotel_id], references: [id], onDelete: Cascade)
  orcamentos Orcamento[]

  @@index([hotel_id])
  @@index([hotel_id, email])
  @@index([hotel_id, telefone])
  @@map("leads")
}

model Orcamento {
  id                    String            @id @default(uuid())
  hotel_id              String
  lead_id               String
  regime_alimentacao_id String
  categoria_quarto_id   String
  check_in              String            @db.VarChar(10)
  check_out             String            @db.VarChar(10)
  quantidade_adultos    Int               @default(1)
  quantidade_criancas   Int               @default(0)
  quantidade_pets       Int               @default(0)
  valor_total           String            @db.VarChar(20)
  detalhamento_noites   Json
  token_publico         String            @unique @db.VarChar(64)
  status                String            @default("pendente") @db.VarChar(20)
  observacoes           String?           @db.Text
  cupom_desconto        String?           @db.VarChar(50)
  created_at            DateTime          @default(now())
  updated_at            DateTime          @updatedAt

  hotel                 Hotel             @relation(fields: [hotel_id], references: [id], onDelete: Cascade)
  lead                  Lead              @relation(fields: [lead_id], references: [id], onDelete: Restrict)
  regime_alimentacao    RegimeAlimentacao @relation(fields: [regime_alimentacao_id], references: [id], onDelete: Restrict)
  categoria_quarto      CategoriaQuarto   @relation(fields: [categoria_quarto_id], references: [id], onDelete: Restrict)

  @@index([hotel_id])
  @@index([hotel_id, status])
  @@index([lead_id])
  @@index([token_publico])
  @@map("orcamentos")
}

model ParceiroComercial {
  id                    String             @id @default(uuid())
  hotel_id              String
  tipo_parceiro         String             @db.VarChar(30)
  tipo_pessoa           String             @db.Char(2)
  razao_social          String             @db.VarChar(150)
  nome_fantasia         String?            @db.VarChar(150)
  documento             String?            @db.VarChar(20)
  inscricao_estadual    String?            @db.VarChar(30)
  estrangeiro           Boolean            @default(false)
  cadastur              String?            @db.VarChar(30)
  codigo_iata           String?            @db.VarChar(20)
  registro_embratur     String?            @db.VarChar(30)

  // Endereço
  logradouro            String?            @db.VarChar(120)
  numero                String?            @db.VarChar(20)
  complemento           String?            @db.VarChar(50)
  bairro                String?            @db.VarChar(60)
  cidade                String?            @db.VarChar(60)
  estado                String?            @db.VarChar(2)
  cep                   String?            @db.VarChar(10)
  pais                  String             @default("Brasil") @db.VarChar(50)

  // Regras Comerciais
  modelo_tarifario      String             @default("comissionada") @db.VarChar(20)
  comissao_padrao       Decimal            @default(0.00) @db.Decimal(5, 2)
  politica_faturamento  String             @default("prepago") @db.VarChar(20)
  prazo_pagamento_dias  Int                @default(0)
  limite_credito        Decimal            @default(0.00) @db.Decimal(12, 2)
  allotment_quartos     Int                @default(0)

  // Ciclo de vida e observações
  status                String             @default("ativo") @db.VarChar(20)
  motivo_bloqueio       String?            @db.Text
  observacoes           String?            @db.Text
  criado_em             DateTime           @default(now())
  atualizado_em         DateTime           @updatedAt

  hotel                 Hotel              @relation(fields: [hotel_id], references: [id], onDelete: Cascade)
  contatos              ParceiroContato[]
  reservas              Reserva[]

  @@unique([hotel_id, documento])
  @@index([hotel_id])
  @@index([hotel_id, tipo_parceiro])
  @@index([hotel_id, status])
  @@index([hotel_id, razao_social])
  @@map("parceiros_comerciais")
}

model ParceiroContato {
  id           String            @id @default(uuid())
  parceiro_id  String
  tipo_contato String            @db.VarChar(20)
  nome         String            @db.VarChar(100)
  email        String            @db.VarChar(150)
  telefone     String            @db.VarChar(30)
  cargo        String?           @db.VarChar(50)
  criado_em    DateTime          @default(now())

  parceiro     ParceiroComercial @relation(fields: [parceiro_id], references: [id], onDelete: Cascade)

  @@index([parceiro_id])
  @@index([parceiro_id, tipo_contato])
  @@map("parceiros_contatos")
}

model Reserva {
  id                    String             @id @default(uuid())
  hotel_id              String
  codigo                String             @db.VarChar(20)
  titular_nome          String             @db.VarChar(150)
  titular_telefone      String?            @db.VarChar(30)
  titular_email         String?            @db.VarChar(150)
  quarto_id             String
  regime_alimentacao_id String
  parceiro_comercial_id String?
  check_in              DateTime           @db.Date
  check_out             DateTime           @db.Date
  quantidade_adultos    Int
  quantidade_criancas   Int                @default(0)
  valor_total           Decimal            @db.Decimal(12, 2)
  detalhamento_diarias  Json
  status                String             @default("a_confirmar") @db.VarChar(20)
  token_fnrh            String             @unique @db.VarChar(64)
  token_fnrh_ativo      Boolean            @default(true)
  fnrh_enviada_em       DateTime?
  observacoes           String?            @db.Text
  created_at            DateTime           @default(now())
  updated_at            DateTime           @updatedAt

  hotel                 Hotel              @relation(fields: [hotel_id], references: [id], onDelete: Cascade)
  quarto                Quarto             @relation(fields: [quarto_id], references: [id], onDelete: Restrict)
  regime_alimentacao    RegimeAlimentacao  @relation(fields: [regime_alimentacao_id], references: [id], onDelete: Restrict)
  parceiro_comercial    ParceiroComercial? @relation(fields: [parceiro_comercial_id], references: [id], onDelete: SetNull)
  hospedes              ReservaHospede[]
  historico_status      ReservaStatusHistorico[]

  @@unique([hotel_id, codigo])
  @@index([hotel_id])
  @@index([hotel_id, status])
  @@index([hotel_id, check_in])
  @@index([quarto_id, check_in, check_out])
  @@index([parceiro_comercial_id])
  @@map("reservas")
}

model ReservaHospede {
  id                  String    @id @default(uuid())
  reserva_id          String
  posicao             Int
  ficha_status        String    @default("pendente") @db.VarChar(12)
  preenchido_por      String?   @db.VarChar(10)
  preenchido_em       DateTime?

  // FNRH
  nome_completo       String?   @db.VarChar(150)
  nacionalidade       String?   @db.VarChar(60)
  data_nascimento     DateTime? @db.Date
  sexo                String?   @db.VarChar(15)
  profissao           String?   @db.VarChar(80)
  tipo_documento      String?   @db.VarChar(15)
  numero_documento    String?   @db.VarChar(30)
  logradouro          String?   @db.VarChar(120)
  numero_endereco     String?   @db.VarChar(20)
  complemento         String?   @db.VarChar(50)
  bairro              String?   @db.VarChar(60)
  cidade              String?   @db.VarChar(60)
  estado              String?   @db.VarChar(2)
  cep                 String?   @db.VarChar(10)
  pais_residencia     String?   @db.VarChar(60)
  telefone            String?   @db.VarChar(30)
  email               String?   @db.VarChar(150)
  motivo_viagem       String?   @db.VarChar(30)
  meio_transporte     String?   @db.VarChar(30)
  procedencia         String?   @db.VarChar(100)
  proximo_destino     String?   @db.VarChar(100)
  responsavel_posicao Int?

  reserva             Reserva   @relation(fields: [reserva_id], references: [id], onDelete: Cascade)

  @@unique([reserva_id, posicao])
  @@map("reserva_hospedes")
}

model ReservaStatusHistorico {
  id              String   @id @default(uuid())
  reserva_id      String
  status_anterior String?  @db.VarChar(20)
  status_novo     String   @db.VarChar(20)
  user_id         String?
  created_at      DateTime @default(now())

  reserva         Reserva  @relation(fields: [reserva_id], references: [id], onDelete: Cascade)

  @@index([reserva_id])
  @@map("reserva_status_historico")
}
